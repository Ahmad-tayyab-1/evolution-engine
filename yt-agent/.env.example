# --- LLM (script, ideas, SEO, strategy reasoning) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Voice ---
DEEPGRAM_API_KEY=
DEEPGRAM_VOICE_MODEL=aura-asteria-en

# --- Image gen (pollinations.ai - no key required) ---
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt

# --- YouTube ---
YT_CLIENT_SECRET_FILE=./secrets/client_secret.json
YT_TOKEN_FILE=./secrets/token.json
YT_CHANNEL_NAME=

# --- DB (switchable: sqlite | postgresql | mysql) ---
DB_BACKEND=sqlite
DB_PATH=./db/agent.db
# for postgres/mysql:
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Cadence / loop ---
LOOP_INTERVAL_MINUTES=30
UPLOADS_PER_DAY_CAP=6
DAILY_QUOTA_UNITS=100000
COMMENT_AUTO_REPLY=false
# false = agent drafts replies into review queue, you approve via CLI
# true = agent posts replies immediately

# --- Monetization goal (YPP thresholds, do not need to edit) ---
GOAL_SUBS=1000
GOAL_WATCH_HOURS=4000
GOAL_SHORTS_VIEWS_90D=10000000

# --- Channel branding auto-SEO (description + keywords only) ---
BRANDING_REFRESH_DAYS=14
# how often to regenerate channel description/keywords once niche is
# locked, using whatever topics are performing best by then

# --- Niche discovery ---
NICHE_DISCOVERY_DAYS=5
# 5 candidate niches over 5 days at UPLOADS_PER_DAY_CAP=6 gives ~6 videos
# per niche - a real sample instead of 2-3. Edit agent/niches.py to
# change/add candidates before starting.
NICHE_MIN_VIDEOS=4
# minimum uploaded+measured videos per niche before discovery is allowed to
# conclude - prevents locking in a winner off a single lucky video

# --- Self-evolution system ---
EVOLVE_EVERY_N_CYCLES=12
# how many loop cycles between evolution runs (competitor scan + genome eval).
# 12 cycles * 30min interval = every ~6 hours. Lower = faster but noisier
# adaptation; needs enough videos to accumulate metrics between runs.
CANDIDATE_TRAFFIC_SHARE=0.3
# fraction of new videos that try the current A/B candidate genome vs control
EVOLVE_MIN_SAMPLE=4
# minimum uploaded+measured videos before a candidate genome is judged
EVOLVE_IMPROVEMENT_MARGIN=0.10
# candidate must beat (or lose to) control by this fraction to be promoted/retired
